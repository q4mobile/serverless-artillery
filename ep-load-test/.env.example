# Load-test environment variables — copy to `.env` (gitignored) and fill in
# real values. Usage: `source .env` in this shell before running npm scripts /
# artillery, so you don't have to prefix every command with these vars.
#
# See README.md ("Dial-out env vars" + create-events/registration sections)
# and .claude/skills/ep-load-test/SKILL.md for what each var controls and how
# origination/target sides can be mixed independently (prod->stage,
# stage->prod, prod->prod, stage->stage).

# --- AWS profiles ---
# Named CLI profiles for the origination side (owns LOAD_TEST_SMA_ID) and the
# target side under test (DynamoDB participant poll). Can be the same profile
# if both sides are the same account.
export LOAD_TEST_CHIME_AWS_PROFILE=q4events-stage
export LOAD_TEST_TARGET_AWS_PROFILE=q4events-prod
export AWS_REGION=us-east-1

# --- Dial-out (Chime SMA) ---
# Dedicated test SMA id — deployed via .deploy/chime-load-test-sma/ — never production.
export LOAD_TEST_SMA_ID=00000000-0000-0000-0000-000000000000
# E.164 caller id for the outbound leg.
export LOAD_TEST_FROM_PHONE=+10000000000
# E.164 PSTN number the SMA answers on — determines which environment's IVR
# (and therefore which environment is actually under test) picks up the call.
export LOAD_TEST_TO_PHONE=+10000000000
export DIALOUT_PARTICIPANTS_TABLE_NAME=events-streaming-serverless-conference-participants-stage
# Prod's real inbound conferencing SMA id — safety guard, the processor
# refuses to start if LOAD_TEST_SMA_ID matches it. Never remove.
export PRODUCTION_SMA_ID=00000000-0000-0000-0000-000000000000
# The events-streaming SMA that ANSWERS LOAD_TEST_TO_PHONE (i.e. the target env's
# own conferencing SMA — for stage: events-streaming-stage-sip-media-app).
# Because both numbers live in one AWS account, every analyst burns two legs against
# the "SIP Media Application Active Call Limit" quota: the outbound one on
# LOAD_TEST_SMA_ID and the inbound one here. `npm run cleanup-run` needs this to sweep
# the second half — without it, cleanup silently leaves those legs billable and still
# prints a green summary. Find it with:
#   aws chime-sdk-voice list-sip-media-applications --region us-east-1
export CONFERENCE_SMA_ID=00000000-0000-0000-0000-000000000000

# --- Target env (create-events / register-analysts / broadcast / end-event) ---
export EP_API_GRAPHQL_BASE_URL=https://dev.events.q4inc.com
export EP_COMPANY_ID=000000000000000000000000
export EP_API_BASE_URL=https://attendees.dev.events.q4inc.com/rest/v1
export EVENTS_PLAN_PATH=./data/events-plan.json

# --- Secrets: fill these in yourself, never commit real values ---
# Admin platform JWT from browser localStorage (<env>.authToken-platform).
# Expires (~1-24h depending on env) — refresh when 401s start.
export Q4_ADMIN_TOKEN=
